# Copy this file to config/pipeline.env and edit paths for your system.

# Directory containing this repository.
PIPELINE_DIR="/path/to/ONT_tickborne_pipeline"

# Reference files.
HOST_REF="/path/to/Homosapiens_GRCh38.p14.fna"
PATHOGEN_REF="${PIPELINE_DIR}/references/genome.fasta"
BLAST_DB="/path/to/Tick-borne_db/bacterial_and_common_protozoa_genomes"

# Custom demultiplexing files.
BARCODES_CSV="${PIPELINE_DIR}/config/barcodes.csv"
BARCODING_TEMPLATE_TOML="${PIPELINE_DIR}/guppy_data/barcoding/barcoding_arrangements/barcode_arrs_dual_custom_template.toml"
GUPPY_DATA_PATH="${PIPELINE_DIR}/guppy_data/barcoding"
GUPPY_BARCODER="/path/to/ont-guppy-cpu/bin/guppy_barcoder"

# Runtime settings.
THREADS=50
MIN_BARCODE_SCORE=95
MIN_READ_LENGTH=400
MIN_PHRED_QUALITY=10
MIN_MAPQ=10
